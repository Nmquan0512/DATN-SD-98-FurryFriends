@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FuryFriend - Thành Công</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/dangkystyle.css" rel="stylesheet" />
</head>
<body>
    <div class="bg-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <div class="signup-container" style="text-align: center;">
        <div class="logo-section">
            <div class="logo">FuryFriend</div>
        </div>
        <i class="bi bi-check-circle-fill" style="font-size: 60px; color: #10b981; margin-bottom: 20px;"></i>
        <center><div class="welcome-text">Thành Công!</div></center>
        <p style="color:#555; line-height: 1.6;">
            Mật khẩu của bạn đã được đặt lại thành công.
            <br>
            Bây giờ bạn có thể đăng nhập bằng mật khẩu mới.
        </p>
        <div class="login-link">
            <a asp-controller="KhachHangLogin" asp-action="DangNhap" class="signup-btn" style="text-decoration:none; display:inline-block; margin-top:20px;">Đăng nhập ngay</a>
        </div>
    </div>
</body>
</html>