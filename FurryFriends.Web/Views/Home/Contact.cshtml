                    FuryFriend nằm tại trung tâm thành phố, dễ dàng tiếp cận bằng xe buýt, 
                    taxi hoặc xe máy. Chúng tôi có bãi đỗ xe miễn phí cho khách hàng.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ✅ FAQ Section -->
<section class="content-section" id="faq-section">
    <div class="section-container">
        <h2 class="section-title">Câu hỏi thường gặp</h2>
        <div class="faq-section">
            <div class="faq-item">
                <div class="faq-question" onclick="toggleFAQ(this)">
                    Làm thế nào để đặt hàng online?
                    <span class="faq-toggle">+</span>
                </div>
                <div class="faq-answer">
                    Bạn có thể đặt hàng dễ dàng thông qua website của chúng tôi. Chỉ cần chọn sản phẩm, 
                    thêm vào giỏ hàng và tiến hành thanh toán. Chúng tôi hỗ trợ nhiều phương thức thanh toán 
                    như VNPay, chuyển khoản ngân hàng và thanh toán khi nhận hàng (COD).
                </div>
            </div>
            
            <div class="faq-item">
                <div class="faq-question" onclick="toggleFAQ(this)">
                    Thời gian giao hàng là bao lâu?
                    <span class="faq-toggle">+</span>
                </div>
                <div class="faq-answer">
                    Thời gian giao hàng phụ thuộc vào địa chỉ của bạn. Trong nội thành TP.HCM, 
                    chúng tôi giao hàng trong vòng 2-4 giờ. Các tỉnh lân cận mất 1-2 ngày. 
                    Chúng tôi luôn cập nhật trạng thái giao hàng cho bạn.
                </div>
            </div>
            
            <div class="faq-item">
                <div class="faq-question" onclick="toggleFAQ(this)">
                    Có thể đổi trả sản phẩm không?
                    <span class="faq-toggle">+</span>
                </div>
                <div class="faq-answer">
                    Chúng tôi chấp nhận đổi trả sản phẩm trong vòng 7 ngày kể từ ngày nhận hàng, 
                    với điều kiện sản phẩm còn nguyên vẹn và đầy đủ phụ kiện. Chúng tôi sẽ hoàn tiền 
                    hoặc đổi sản phẩm khác theo yêu cầu của bạn.
                </div>
            </div>
            
            <div class="faq-item">
                <div class="faq-question" onclick="toggleFAQ(this)">
                    Có dịch vụ tư vấn thú y không?
                    <span class="faq-toggle">+</span>
                </div>
                <div class="faq-answer">
                    Có! Chúng tôi có đội ngũ bác sĩ thú y chuyên nghiệp, sẵn sàng tư vấn về 
                    chăm sóc sức khỏe, dinh dưỡng và điều trị bệnh cho thú cưng. Bạn có thể 
                    đặt lịch tư vấn qua điện thoại hoặc đến trực tiếp cửa hàng.
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // ✅ Scroll-based Loading với Intersection Observer
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, observerOptions);

        // ✅ Observe tất cả content sections
        document.addEventListener('DOMContentLoaded', function() {
            const sections = document.querySelectorAll('.content-section');
            sections.forEach(section => {
                observer.observe(section);
            });
        });

        // ✅ Toggle FAQ
        function toggleFAQ(element) {
            const faqItem = element.parentElement;
            const isActive = faqItem.classList.contains('active');
            
            // Đóng tất cả FAQ items
            document.querySelectorAll('.faq-item').forEach(item => {
                item.classList.remove('active');
            });
            
            // Mở FAQ item được click (nếu chưa mở)
            if (!isActive) {
                faqItem.classList.add('active');
            }
        }

        // ✅ Handle Contact Form
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const submitBtn = document.getElementById('submitBtn');
            const submitText = submitBtn.querySelector('.submit-text');
            const submitLoading = submitBtn.querySelector('.submit-loading');
            
            // Hiển thị loading state
            submitBtn.classList.add('form-loading');
            submitText.style.display = 'none';
            submitLoading.style.display = 'inline';
            
            // Simulate form submission (thay thế bằng API call thực tế)
            setTimeout(() => {
                // Reset form
                this.reset();
                
                // Hiển thị success state
                submitBtn.classList.remove('form-loading');
                submitBtn.classList.add('form-success');
                submitBtn.textContent = '✅ Gửi thành công!';
                
                // Reset sau 3 giây
                setTimeout(() => {
                    submitBtn.classList.remove('form-success');
                    submitBtn.innerHTML = `
                        <span class="submit-text">Gửi tin nhắn</span>
                        <span class="submit-loading" style="display: none;">
                            <i class="fas fa-spinner fa-spin"></i> Đang gửi...
                        </span>
                    `;
                }, 3000);
                
            }, 2000);
        });

        // ✅ Form validation
        const inputs = document.querySelectorAll('.form-input');
        inputs.forEach(input => {
            input.addEventListener('blur', function() {
                if (this.hasAttribute('required') && !this.value.trim()) {
                    this.style.borderColor = '#f56565';
                } else {
                    this.style.borderColor = '#e2e8f0';
                }
            });
            
            input.addEventListener('input', function() {
                if (this.style.borderColor === 'rgb(245, 101, 101)') {
                    this.style.borderColor = '#e2e8f0';
                }
            });
        });

        // ✅ Smooth scroll cho navigation
        function smoothScrollTo(elementId) {
            const element = document.getElementById(elementId);
            if (element) {
                element.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        }
    </script>
}
