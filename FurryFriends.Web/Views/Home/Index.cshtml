    /* Tooltip tự động hiện lên */
    .chat-tooltip {
        position: absolute;
        bottom: 80px;
        right: 0;
        background: #2d3436;
        color: #fff;
        padding: 10px 14px;
        border-radius: 12px;
        font-size: 13px;
        font-family: 'Nunito', sans-serif;
        white-space: nowrap;
        opacity: 0;
        transform: translateY(10px) scale(0.8);
