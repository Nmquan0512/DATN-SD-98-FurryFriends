@model IEnumerable<FurryFriends.Web.ViewModels.PhieuHoanTraViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Phiếu hoàn trả";
    var hoaDonId = (Guid)(ViewBag.HoaDonId ?? Guid.Empty);
}
@section Styles {
    <style>
        :root {
            --primary: #6366f1;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --border: #e2e8f0;
            --grad: linear-gradient(135deg,#667eea 0%,#764ba2 100%)
        }

        .pg-wrap {
            max-width: 1200px;
            margin: 2rem auto;
            background: #fff;
            border-radius: 24px;
            box-shadow: 0 25px 50px rgba(0,0,0,.12);
            overflow: hidden
        }

        .pg-head {
            background: var(--grad);
            color: #fff;
            padding: 2rem
        }

            .pg-head h2 {
                font-weight: 800;
                margin: 0
            }

        .toolbar {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            gap: .75rem;
            flex-wrap: wrap;
            align-items: center
        }

        .table-wrap {
            padding: 1rem 1.25rem
        }

        .badge-pill {
            border-radius: 999px;
            padding: .35rem .65rem;
            font-weight: 700
        }

        .status-0 {
            background: #fff7ed;
            color: #b45309;
            border: 1px solid #fed7aa
        }

        .status-1 {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0
        }

        .status-2 {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca
        }

        .btn-primary {
            background: var(--grad);
            border: none;
            font-weight: 800
        }
    </style>
}

<div class="pg-wrap">
    <div class="pg-head">
        <h2><i class="fas fa-rotate-left"></i> Phiếu hoàn trả theo hóa đơn</h2>
        <div class="opacity-75">Mã hóa đơn: <strong>@hoaDonId</strong></div>
    </div>

    <div class="toolbar">
        <a class="btn btn-primary" asp-action="Create" asp-route-hoaDonId="@hoaDonId">
            <i class="fas fa-plus-circle"></i> Tạo phiếu hoàn
        </a>
        <div class="ms-auto d-flex gap-2">
            <input id="q" class="form-control" placeholder="Tìm theo sản phẩm / lý do..." />
            <select id="st" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="0">Chờ xử lý</option>
                <option value="1">Đã duyệt</option>
                <option value="2">Từ chối</option>
            </select>
            <button class="btn btn-outline-secondary" onclick="filterRows()"><i class="fas fa-filter"></i> Lọc</button>
        </div>
    </div>

    <div class="table-wrap">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle" id="rtTable">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-center">Số lượng</th>
                        <th>Ngày hoàn</th>
                        <th>Lý do</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6">
                                <div class="text-center p-4 text-muted">
                                    <i class="fas fa-inbox"></i> Chưa có phiếu hoàn nào.
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr data-status="@item.TrangThai">
                                <td class="fw-semibold">@item.TenSanPham</td>
                                <td class="text-center">@item.SoLuongHoan</td>
                                <td>@(item.NgayHoanTra == default ? "-" : item.NgayHoanTra.ToString("dd/MM/yyyy"))</td>
                                <td class="text-truncate" style="max-width:360px">@item.LyDoHoanTra</td>
                                <td class="text-center">
                                    @if (item.TrangThai == 0)
                                    {
                                        <span class="badge badge-pill status-0">Chờ xử lý</span>
                                    }
                                    else if (item.TrangThai == 1)
                                    {
                                        <span class="badge badge-pill status-1">Đã duyệt</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pill status-2">Từ chối</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@item.PhieuHoanTraId">
                                        <i class="fas fa-eye"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterRows(){
            const q = (document.getElementById('q').value||'').toLowerCase().trim();
            const st = document.getElementById('st').value;
            document.querySelectorAll('#rtTable tbody tr').forEach(tr=>{
                const name = (tr.children[0]?.innerText||'').toLowerCase();
                const reason = (tr.children[3]?.innerText||'').toLowerCase();
                const okQ = !q || name.includes(q) || reason.includes(q);
                const okS = !st || tr.getAttribute('data-status')===st;
                tr.style.display = (okQ && okS)?'':'none';
            });
        }
    </script>
}
