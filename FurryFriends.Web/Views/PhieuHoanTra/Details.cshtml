@model FurryFriends.Web.ViewModels.PhieuHoanTraViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Chi tiết phiếu hoàn";
}
@section Styles {
    <style>
        .page {
            max-width: 900px;
            margin: 2rem auto;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 20px 45px rgba(0,0,0,.12);
            overflow: hidden
        }

        .head {
            background: linear-gradient(135deg,#667eea 0%,#764ba2 100%);
            color: #fff;
            padding: 1.75rem
        }

            .head h3 {
                margin: 0;
                font-weight: 800
            }

        .body {
            padding: 1.25rem
        }

        .kv {
            display: grid;
            grid-template-columns: 200px 1fr;
            gap: .5rem .75rem;
            margin: .25rem 0
        }

        .badge-pill {
            border-radius: 999px;
            padding: .35rem .65rem;
            font-weight: 700
        }

        .s0 {
            background: #fff7ed;
            color: #b45309;
            border: 1px solid #fed7aa
        }

        .s1 {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0
        }

        .s2 {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca
        }

        .card {
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 1rem
        }
    </style>
}
<div class="page">
    <div class="head">
        <h3><i class="fas fa-file-invoice"></i> Chi tiết phiếu hoàn</h3>
        <div class="opacity-75">Mã phiếu: <strong>@Model.PhieuHoanTraId</strong></div>
    </div>
    <div class="body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="fw-bold mb-2"><i class="fas fa-box"></i> Sản phẩm</div>
                    <div class="kv"><div class="text-muted">Tên</div><div class="fw-semibold">@Model.TenSanPham</div></div>
                    <div class="kv"><div class="text-muted">Số lượng hoàn</div><div>@Model.SoLuongHoan</div></div>
                    <div class="kv"><div class="text-muted">Ngày yêu cầu</div><div>@(Model.NgayHoanTra == default ? "-" : Model.NgayHoanTra.ToString("dd/MM/yyyy"))</div></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="fw-bold mb-2"><i class="fas fa-info-circle"></i> Thông tin</div>
                    <div class="kv"><div class="text-muted">Lý do</div><div>@Model.LyDoHoanTra</div></div>
                    <div class="kv">
                        <div class="text-muted">Trạng thái</div>
                        <div>
                            @if (Model.TrangThai == 0)
                            {
                                <span class="badge badge-pill s0">Chờ xử lý</span>
                            }
                            else if (Model.TrangThai == 1)
                            {
                                <span class="badge badge-pill s1">Đã duyệt</span>
                            }
                            else
                            {
                                <span class="badge badge-pill s2">Từ chối</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-hoaDonId="@Model.HoaDonChiTietId">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
            <!-- Nếu cho phép khách tự xóa yêu cầu khi đang chờ: -->
            @if (Model.TrangThai == 0)
            {
                <form asp-action="Delete" method="post" class="ms-auto"
                      onsubmit="return confirm('Bạn muốn hủy phiếu hoàn này?');">
                    <input type="hidden" name="id" value="@Model.PhieuHoanTraId" />
                    <input type="hidden" name="hoaDonId" value="@Model.HoaDonChiTietId" />
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="fas fa-trash"></i> Hủy yêu cầu
                    </button>
                </form>
            }
        </div>
    </div>
</div>
