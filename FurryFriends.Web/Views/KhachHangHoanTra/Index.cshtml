@model IEnumerable<FurryFriends.Web.ViewModels.PhieuHoanTraViewModel>
@{
    ViewData["Title"] = "Yêu cầu hoàn trả của tôi";
    Layout = "_Layout";

    string StatusText(int s) => s switch
    {
        0 => "Đang chờ duyệt",
        1 => "Đã duyệt",
        2 => "Bị từ chối",
        3 => "Hoàn thành",
        _ => "Không xác định"
    };
    string StatusClass(int s) => s switch
    {
        0 => "badge bg-warning text-dark",
        1 => "badge bg-info text-dark",
        2 => "badge bg-danger",
        3 => "badge bg-success",
        _ => "badge bg-secondary"
    };
    string Img(string? p)
    {
        if (string.IsNullOrWhiteSpace(p)) return "";
        if (p.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return p;
        if (p.Contains("/")) return "https://localhost:7289/" + p.TrimStart('/');
        return $"https://localhost:7289/images/{System.IO.Path.GetFileName(p)}";
    }

    var groups = (Model ?? Enumerable.Empty<FurryFriends.Web.ViewModels.PhieuHoanTraViewModel>())
                 .GroupBy(x => x.HoaDonChiTietId)
                 .ToList();
}

<section class="container py-4">
    <h2 class="mb-4"><i class="bi bi-arrow-counterclockwise"></i> Yêu cầu hoàn trả của tôi</h2>

    @if (!groups.Any())
    {
        <div class="alert alert-info">Bạn chưa có yêu cầu hoàn trả nào.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded bg-white">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:72px;"></th>
                        <th>Sản phẩm</th>
                        <th class="text-center">Đã mua</th>
                        <th class="text-center">Đã hoàn</th>
                        <th class="text-center">Còn lại</th>
                        <th>Phiếu gần nhất</th>
                        <th class="text-center">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in groups)
                    {
                        // lấy 1 item đại diện để show thông tin snapshot (tên/màu/size/ảnh)
                        var any = g.OrderByDescending(x => x.NgayHoanTra).First();
                        var img = Img(any.AnhSanPham);

                        // Tổng mua lấy từ API DTO (đã thêm)
                        var tongMua = any.TongSoLuongMua;

                        // Đã hoàn: sum các phiếu KHÔNG bị từ chối
                        var daHoan = g.Where(x => x.TrangThai != 2).Sum(x => x.SoLuongHoan);

                        var conLai = Math.Max(0, tongMua - daHoan);

                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(img))
                                {
                                    <img src="@img" class="rounded" style="width:56px;height:56px;object-fit:cover;border:1px solid #eee;" />
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@any.TenSanPham</div>
                                <small class="text-muted">Màu: @any.MauSac • Size: @any.KichCo</small>
                            </td>
                            <td class="text-center fw-semibold">@tongMua</td>
                            <td class="text-center">@daHoan</td>
                            <td class="text-center fw-bold text-success">@conLai</td>
                            <td>
                                @* Hiển thị phiếu mới nhất để người dùng nắm trạng thái gần đây *@
                                <div class="@StatusClass(any.TrangThai)">@StatusText(any.TrangThai)</div>
                                <small class="text-muted d-block mt-1">@any.NgayHoanTra.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td class="text-center">
                                <a asp-controller="KhachHangHoanTra"
                                   asp-action="Details"
                                   asp-route-id="@any.PhieuHoanTraId"
                                   class="btn btn-sm btn-outline-primary">
                                    Xem phiếu mới nhất
                                </a>
                            </td>
                        </tr>

                        @* Nếu muốn show các phiếu con của cùng sản phẩm ngay dưới, mở comment block dưới *@
                        
                    <tr>
                        <td></td>
                        <td colspan="6">
                            <div class="border rounded p-2 bg-light">
                                <div class="fw-semibold mb-2">Các phiếu đã gửi cho sản phẩm này</div>
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Mã phiếu</th>
                                                <th>Ngày</th>
                                                <th class="text-center">SL hoàn</th>
                                                <th>Trạng thái</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var p in g.OrderByDescending(x => x.NgayHoanTra))
                                        {
                                            <tr>
                                                <td class="text-monospace">@p.PhieuHoanTraId</td>
                                                <td>@p.NgayHoanTra.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="text-center">@p.SoLuongHoan</td>
                                                <td><span class="@StatusClass(p.TrangThai)">@StatusText(p.TrangThai)</span></td>
                                                <td class="text-end">
                                                    <a asp-controller="KhachHangHoanTra" asp-action="Details" asp-route-id="@p.PhieuHoanTraId" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                                                </td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </td>
                    </tr>
                   
                    }
                </tbody>
            </table>
        </div>
    }
</section>
