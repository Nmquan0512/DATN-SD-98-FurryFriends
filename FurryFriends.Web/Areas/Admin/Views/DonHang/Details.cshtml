@model FurryFriends.API.Models.HoaDon
@{
    ViewData["Title"] = "Chi tiết đơn hàng - Admin";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="fas fa-file-invoice-dollar me-2 text-primary"></i>Chi tiết đơn hàng</h2>
        <a href="@Url.Action("Index", "DonHang", new { area = "Admin" })" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-shopping-cart me-2"></i>
                Đơn hàng #@Model.HoaDonId.ToString().Substring(0, 8).ToUpper()
                <span class="badge bg-light text-dark ms-2">@GetStatusText(Model.TrangThai)</span>
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
            <!-- Thông tin khách hàng -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="fas fa-user me-2 text-primary"></i>Thông tin khách hàng</h6>
            </div>
                        <div class="card-body">
                            <table class="table table-borderless">
                                <tr>
                                    <td class="fw-bold" style="width: 120px;">Họ tên:</td>
                                    <td>@(Model.TenCuaKhachHang ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Số điện thoại:</td>
                                    <td>@(Model.SdtCuaKhachHang ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Email:</td>
                                    <td>@(Model.EmailCuaKhachHang ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Địa chỉ:</td>
                                    <td>@(Model.DiaChiGiaoHangLucMua ?? Model.DiaChiGiaoHang?.TenDiaChi ?? "N/A")</td>
                                </tr>
                            </table>
                </div>
                </div>
            </div>

            <!-- Thông tin đơn hàng -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="fas fa-receipt me-2 text-success"></i>Thông tin đơn hàng</h6>
            </div>
                        <div class="card-body">
                            <table class="table table-borderless">
                                <tr>
                                    <td class="fw-bold" style="width: 120px;">Mã đơn hàng:</td>
                                    <td>@Model.HoaDonId</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Ngày tạo:</td>
                                    <td>@Model.NgayTao.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Trạng thái:</td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(Model.TrangThai)">
                            @GetStatusText(Model.TrangThai)
                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Phương thức thanh toán:</td>
                                    <td>
                        @if (Model.LoaiHoaDon == "BanTaiQuay")
                        {
                            <span class="text-success fw-semibold">Đã thanh toán</span>
                        }
                        else
                        {
                            @(Model.HinhThucThanhToan?.TenHinhThuc ?? "N/A")
                        }
                                    </td>
                                </tr>
                @if (Model.ThoiGianThayDoiTrangThai.HasValue)
                                {
                                    <tr>
                                        <td class="fw-bold">Cập nhật cuối:</td>
                                        <td>@Model.ThoiGianThayDoiTrangThai.Value.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    </tr>
                                }
                            </table>
                                </div>
                        </div>
                    </div>
            </div>

            <!-- Chi tiết sản phẩm -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="fas fa-box-open me-2 text-warning"></i>Chi tiết sản phẩm</h6>
            </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">Loại</th>
                                    <th class="text-center">Đơn giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-center">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                @if (Model.HoaDonChiTiets != null && Model.HoaDonChiTiets.Any())
                {
                    @foreach (var item in Model.HoaDonChiTiets)
                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                            @{ 
                                string imgLink = null; 
                                var snapshotImg = item.AnhSanPhamLucMua ?? string.Empty;
                                var currentImg = item.SanPhamChiTiet?.Anh?.DuongDan ?? string.Empty;
                                var dd = !string.IsNullOrWhiteSpace(snapshotImg) ? snapshotImg : currentImg;
                                
                                if (!string.IsNullOrWhiteSpace(dd)) { 
                                    if (dd.StartsWith("http", StringComparison.OrdinalIgnoreCase)) 
                                        imgLink = dd; 
                                    else if (dd.Contains("/")) 
                                        imgLink = "https://localhost:7289/" + dd.TrimStart('/'); 
                                    else 
                                        imgLink = $"https://localhost:7289/images/{System.IO.Path.GetFileName(dd)}"; 
                                } 
                            }
                            @if (!string.IsNullOrEmpty(imgLink)) 
                            {
                                                        <img src="@imgLink" alt="@(item.TenSanPhamLucMua ?? "Sản phẩm")" class="me-3" style="width: 48px; height: 48px; object-fit: cover; border-radius: 6px;">
                            } 
                            else 
                            {
                                                        <div class="me-3" style="width: 48px; height: 48px; background-color: #f0f0f0; border-radius: 6px; display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-image text-muted"></i>
                                </div>
                            }
                                                    <div>
                                                        <div class="fw-semibold">@(item.TenSanPhamLucMua ?? "N/A")</div>
                                @if (!string.IsNullOrEmpty(item.ThuongHieuLucMua))
                                {
                                                            <small class="text-muted">@item.ThuongHieuLucMua</small>
                                }
                                </div>
                            </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark">@(item.MauSacLucMua ?? "N/A")</span>
                                                <span class="badge bg-light text-dark">@(item.KichCoLucMua ?? "N/A")</span>
                                            </td>
                                            <td class="text-center">@((item.GiaLucMua ?? item.Gia).ToString("N0"))đ</td>
                                            <td class="text-center">@item.SoLuongSanPham</td>
                                            <td class="text-center fw-bold">@(((item.GiaLucMua ?? item.Gia) * item.SoLuongSanPham).ToString("N0"))đ</td>
                                        </tr>
                    }
                }
                else
                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                        <i class="fas fa-box-open fa-2x mb-2"></i>
                        <div>Không có sản phẩm nào</div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="text-end fw-semibold">Tổng tiền hàng:</td>
                                    <td class="fw-bold">@Model.TongTien.ToString("N0")đ</td>
                                </tr>
                                @{ 
                                    var phuPhi = 0m;
                                    var coGiaoHang = Model.LoaiHoaDon == "GiaoHang" || !string.IsNullOrEmpty(Model.DiaChiGiaoHangLucMua);
                                    var tongTienSauGiam = Model.TongTienSauKhiGiam;
                                    
                                    if (coGiaoHang && tongTienSauGiam < 500000m)
                                    {
                                        phuPhi = 30000m;
                                    }
                                    
                                    // ✅ Tính giảm giá voucher: Tổng tiền hàng - (Tổng tiền sau giảm - Phí ship)
                                    var voucherDiscount = Math.Max(0m, Model.TongTien - (Model.TongTienSauKhiGiam - phuPhi));
                                }
                                
                                @if (coGiaoHang)
                                {
                                    <tr>
                                        <td colspan="4" class="text-end fw-semibold">Phí vận chuyển:</td>
                                        <td class="fw-bold">@phuPhi.ToString("N0")đ</td>
                                    </tr>
                                }
                                
                    @if (!string.IsNullOrEmpty(Model.ThongTinVoucherLucMua))
                    {
                                    <tr>
                                        <td colspan="4" class="text-end fw-semibold text-success">
                                <i class="fas fa-ticket-alt me-1"></i>
                                Voucher áp dụng:
                                        </td>
                                        <td class="fw-bold text-success">-@voucherDiscount.ToString("N0")đ</td>
                                    </tr>
                    }
                    else if (Model.Voucher != null)
                    {
                                    <tr>
                                        <td colspan="4" class="text-end fw-semibold text-success">
                                <i class="fas fa-ticket-alt me-1"></i>
                                Giảm giá (@Model.Voucher.TenVoucher):
                                        </td>
                                        <td class="fw-bold text-success">-@voucherDiscount.ToString("N0")đ</td>
                                    </tr>
                                }
                                
                                <tr>
                                    <td colspan="4" class="text-end fs-5 fw-bold text-primary">Thành tiền:</td>
                                    <td class="fs-5 fw-bold text-primary">@Model.TongTienSauKhiGiam.ToString("N0")đ</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Các nút hành động -->
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a href="@Url.Action("Index", "DonHang", new { area = "Admin" })" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                </a>

                @if (Model.TrangThai == 0)
                {
                    <button class="btn btn-success" onclick="duyetDon('@Model.HoaDonId')">
                        <i class="fas fa-check me-2"></i>Duyệt đơn
                    </button>
                }

                @if (Model.TrangThai == 1)
                {
                    <button class="btn btn-info" onclick="chuyenSangDangGiao('@Model.HoaDonId')">
                        <i class="fas fa-shipping-fast me-2"></i>Chuyển sang đang giao
                    </button>
                }

                @if (Model.TrangThai == 2)
                {
                    <button class="btn btn-success" onclick="chuyenSangDaGiao('@Model.HoaDonId')">
                        <i class="fas fa-home me-2"></i>Chuyển sang đã giao
                    </button>
                }

                @if (Model.TrangThai == 0 || Model.TrangThai == 1)
                {
                    <button class="btn btn-danger" onclick="huyDon('@Model.HoaDonId')">
                        <i class="fas fa-times me-2"></i>Hủy đơn
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function duyetDon(hoaDonId) {
            if (confirm('Bạn có chắc chắn muốn duyệt đơn hàng này?')) {
                fetch(`/Admin/DonHang/DuyetDon`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: hoaDonId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Có lỗi xảy ra khi duyệt đơn hàng');
                });
            }
        }

        function chuyenSangDangGiao(hoaDonId) {
            if (confirm('Bạn có chắc chắn muốn chuyển đơn hàng sang trạng thái đang giao?')) {
                fetch(`/Admin/DonHang/DoiTrangThai`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: hoaDonId, trangThaiMoi: 2 })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Có lỗi xảy ra khi chuyển trạng thái');
                });
            }
        }

        function chuyenSangDaGiao(hoaDonId) {
            if (confirm('Bạn có chắc chắn muốn chuyển đơn hàng sang trạng thái đã giao?')) {
                fetch(`/Admin/DonHang/DoiTrangThai`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: hoaDonId, trangThaiMoi: 3 })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Có lỗi xảy ra khi chuyển trạng thái');
                });
            }
        }

        function huyDon(hoaDonId) {
            if (confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')) {
                fetch(`/Admin/DonHang/HuyDon`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: hoaDonId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Có lỗi xảy ra khi hủy đơn hàng');
                });
            }
        }
    </script>
}

@functions {
    public string GetStatusText(int trangThai)
    {
        return trangThai switch
        {
            0 => "Chờ duyệt",
            1 => "Đã duyệt",
            2 => "Đang giao",
            3 => "Đã giao",
            4 => "Đã hủy",
            _ => "Không xác định"
        };
    }

    public string GetStatusBadgeClass(int trangThai)
    {
        return trangThai switch
        {
            0 => "bg-warning text-dark",
            1 => "bg-info text-white",
            2 => "bg-primary",
            3 => "bg-success",
            4 => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
