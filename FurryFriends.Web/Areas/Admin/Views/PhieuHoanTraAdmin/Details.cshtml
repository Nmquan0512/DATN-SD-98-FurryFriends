@model FurryFriends.Web.ViewModels.PhieuHoanTraViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản trị - Chi tiết phiếu hoàn";
    var hoaDonId = Model?.HoaDonChiTietId ?? Guid.Empty; // theo controller của bạn đang dùng prop này để quay về Index
}

@section Styles {
    <style>
        .box {
            max-width: 1100px;
            margin: 2rem auto;
            background: #fff;
            border-radius: 22px;
            box-shadow: 0 20px 45px rgba(0,0,0,.12);
            overflow: hidden
        }

        .hd {
            background: linear-gradient(135deg,#667eea 0%,#764ba2 100%);
            color: #fff;
            padding: 1.4rem 1.6rem
        }

            .hd h3 {
                margin: 0;
                font-weight: 800
            }

        .bd {
            padding: 1.25rem
        }

        .kv {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: .5rem .75rem;
            margin: .25rem 0
        }

        .card {
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 1rem
        }

        .badge-pill {
            border-radius: 999px;
            padding: .35rem .65rem;
            font-weight: 700
        }

        .s0 {
            background: #fff7ed;
            color: #b45309;
            border: 1px solid #fed7aa
        }

        .s1 {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0
        }

        .s2 {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca
        }
    </style>
}

<div class="box">
    <div class="hd">
        <h3><i class="fas fa-file-alt"></i> Chi tiết phiếu hoàn</h3>
        <div class="opacity-75">Mã phiếu: <strong>@Model.PhieuHoanTraId</strong></div>
    </div>

    <div class="bd">
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card">
                    <div class="fw-bold mb-2"><i class="fas fa-box"></i> Sản phẩm</div>
                    <div class="kv"><div class="text-muted">Tên sản phẩm</div><div class="fw-semibold">@Model.TenSanPham</div></div>
                    <div class="kv"><div class="text-muted">Số lượng hoàn</div><div>@Model.SoLuongHoan</div></div>
                    <div class="kv"><div class="text-muted">Ngày yêu cầu</div><div>@(Model.NgayHoanTra == default ? "-" : Model.NgayHoanTra.ToString("dd/MM/yyyy"))</div></div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card">
                    <div class="fw-bold mb-2"><i class="fas fa-info-circle"></i> Thông tin yêu cầu</div>
                    <div class="kv"><div class="text-muted">Lý do</div><div>@Model.LyDoHoanTra</div></div>
                    <div class="kv">
                        <div class="text-muted">Trạng thái</div>
                        <div>
                            @if (Model.TrangThai == 0)
                            {
                                <span class="badge badge-pill s0">Chờ xử lý</span>
                            }
                            else if (Model.TrangThai == 1)
                            {
                                <span class="badge badge-pill s1">Đã duyệt</span>
                            }
                            else
                            {
                                <span class="badge badge-pill s2">Từ chối</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3 d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-hoaDonId="@hoaDonId">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>

            @* Tác vụ duyệt/từ chối *@
            @if (Model.TrangThai != 1)
            {
                <form asp-action="UpdateTrangThai" method="post"
                      onsubmit="return confirm('Duyệt phiếu hoàn này?');">
                    <input type="hidden" name="id" value="@Model.PhieuHoanTraId" />
                    <input type="hidden" name="trangThai" value="1" />
                    <input type="hidden" name="hoaDonId" value="@hoaDonId" />
                    <button class="btn btn-success" type="submit">
                        <i class="fas fa-check"></i> Duyệt
                    </button>
                </form>
            }
            @if (Model.TrangThai != 2)
            {
                <form asp-action="UpdateTrangThai" method="post"
                      onsubmit="return confirm('Từ chối phiếu này?');">
                    <input type="hidden" name="id" value="@Model.PhieuHoanTraId" />
                    <input type="hidden" name="trangThai" value="2" />
                    <input type="hidden" name="hoaDonId" value="@hoaDonId" />
                    <button class="btn btn-warning" type="submit">
                        <i class="fas fa-times-circle"></i> Từ chối
                    </button>
                </form>
            }

            <form asp-action="Delete" method="post" class="ms-auto"
                  onsubmit="return confirm('Xóa phiếu này? Hành động không thể hoàn tác.');">
                <input type="hidden" name="id" value="@Model.PhieuHoanTraId" />
                <input type="hidden" name="hoaDonId" value="@hoaDonId" />
                <button class="btn btn-outline-danger" type="submit">
                    <i class="fas fa-trash"></i> Xóa
                </button>
            </form>
        </div>
    </div>
</div>
