@model IEnumerable<FurryFriends.Web.ViewModels.PhieuHoanTraViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản trị - Phiếu hoàn trả";
    var hoaDonId = (Guid)(ViewBag.HoaDonId ?? Guid.Empty);
}

@section Styles {
    <style>
        :root {
            --primary: #6366f1;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --border: #e2e8f0;
            --grad: linear-gradient(135deg,#667eea 0%,#764ba2 100%)
        }

        .pg {
            max-width: 1300px;
            margin: 2rem auto;
            background: #fff;
            border-radius: 24px;
            box-shadow: 0 20px 45px rgba(0,0,0,.12);
            overflow: hidden
        }

        .pg-h {
            background: var(--grad);
            color: #fff;
            padding: 1.5rem 1.75rem
        }

            .pg-h h2 {
                margin: 0;
                font-weight: 800
            }

        .toolbar {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            gap: .75rem;
            flex-wrap: wrap;
            align-items: center
        }

        .table-wrap {
            padding: 1rem 1.25rem
        }

        .badge-pill {
            border-radius: 999px;
            padding: .35rem .65rem;
            font-weight: 700
        }

        .s0 {
            background: #fff7ed;
            color: #b45309;
            border: 1px solid #fed7aa
        }

        .s1 {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0
        }

        .s2 {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca
        }

        .btn-primary {
            background: var(--grad);
            border: none;
            font-weight: 800
        }

        .small {
            font-size: .875rem
        }
    </style>
}
<a asp-area="Admin" asp-controller="PhieuHoanTraAdmin" asp-action="Index">Danh sách phiếu hoàn (Admin)</a>
<div class="pg">
    <div class="pg-h">
        <h2><i class="fas fa-clipboard-list"></i> Quản trị – Phiếu hoàn trả</h2>
        <div class="opacity-75 small">Hóa đơn: <strong>@hoaDonId</strong></div>
    </div>

    <div class="toolbar">
        <div class="d-flex gap-2 flex-wrap">
            <input id="q" class="form-control" placeholder="Tìm sản phẩm / lý do / mã phiếu" />
            <select id="st" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="0">Chờ xử lý</option>
                <option value="1">Đã duyệt</option>
                <option value="2">Từ chối</option>
            </select>
            <input id="from" type="date" class="form-control" />
            <input id="to" type="date" class="form-control" />
            <button class="btn btn-outline-secondary" onclick="filterRows()"><i class="fas fa-filter"></i> Lọc</button>
        </div>
        <div class="ms-auto d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-hoaDonId="@hoaDonId">
                <i class="fas fa-rotate"></i> Tải lại
            </a>
        </div>
    </div>

    <div class="table-wrap">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle" id="tbl">
                <thead class="table-light">
                    <tr>
                        <th style="min-width:200px">Sản phẩm</th>
                        <th class="text-center" style="width:110px">Số lượng</th>
                        <th style="width:130px">Ngày</th>
                        <th>Lý do</th>
                        <th class="text-center" style="width:130px">Trạng thái</th>
                        <th class="text-end" style="width:310px">Tác vụ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted p-4">Chưa có phiếu hoàn nào.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var ngay = item.NgayHoanTra == default ? "" : item.NgayHoanTra.ToString("yyyy-MM-dd");
                            <tr data-status="@item.TrangThai" data-date="@ngay">
                                <td>
                                    <div class="fw-semibold">@item.TenSanPham</div>
                                    <div class="text-muted small">Mã phiếu: @item.PhieuHoanTraId</div>
                                </td>
                                <td class="text-center">@item.SoLuongHoan</td>
                                <td>@(string.IsNullOrEmpty(ngay) ? "-" : DateTime.Parse(ngay).ToString("dd/MM/yyyy"))</td>
                                <td class="text-truncate" style="max-width:380px">@item.LyDoHoanTra</td>
                                <td class="text-center">
                                    @if (item.TrangThai == 0)
                                    {
                                        <span class="badge badge-pill s0">Chờ xử lý</span>
                                    }
                                    else if (item.TrangThai == 1)
                                    {
                                        <span class="badge badge-pill s1">Đã duyệt</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pill s2">Từ chối</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@item.PhieuHoanTraId">
                                        <i class="fas fa-eye"></i> Chi tiết
                                    </a>

                                    @* Duyệt *@
                                    @if (item.TrangThai != 1)
                                    {
                                        <form asp-action="UpdateTrangThai" method="post" class="d-inline"
                                              onsubmit="return confirm('Duyệt phiếu này?');">
                                            <input type="hidden" name="id" value="@item.PhieuHoanTraId" />
                                            <input type="hidden" name="trangThai" value="1" />
                                            <input type="hidden" name="hoaDonId" value="@hoaDonId" />
                                            <button class="btn btn-success btn-sm" type="submit">
                                                <i class="fas fa-check"></i> Duyệt
                                            </button>
                                        </form>
                                    }

                                    @* Từ chối *@
                                    @if (item.TrangThai != 2)
                                    {
                                        <form asp-action="UpdateTrangThai" method="post" class="d-inline"
                                              onsubmit="return confirm('Từ chối phiếu này?');">
                                            <input type="hidden" name="id" value="@item.PhieuHoanTraId" />
                                            <input type="hidden" name="trangThai" value="2" />
                                            <input type="hidden" name="hoaDonId" value="@hoaDonId" />
                                            <button class="btn btn-warning btn-sm" type="submit">
                                                <i class="fas fa-times-circle"></i> Từ chối
                                            </button>
                                        </form>
                                    }

                                    @* Xóa *@
                                    <form asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('Xóa phiếu này?');">
                                        <input type="hidden" name="id" value="@item.PhieuHoanTraId" />
                                        <input type="hidden" name="hoaDonId" value="@hoaDonId" />
                                        <button class="btn btn-outline-danger btn-sm" type="submit">
                                            <i class="fas fa-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterRows(){
            const q=(document.getElementById('q').value||'').toLowerCase().trim();
            const st=document.getElementById('st').value;
            const from=document.getElementById('from').value;
            const to=document.getElementById('to').value;

            document.querySelectorAll('#tbl tbody tr').forEach(tr=>{
                const name=(tr.children[0]?.innerText||'').toLowerCase();
                const reason=(tr.children[3]?.innerText||'').toLowerCase();
                const rowSt=tr.getAttribute('data-status');
                const rowDate=tr.getAttribute('data-date')||'';

                const okQ=!q || name.includes(q) || reason.includes(q);
                const okS=!st || rowSt===st;
                const okF=!from || (rowDate && rowDate>=from);
                const okT=!to || (rowDate && rowDate<=to);

                tr.style.display = (okQ && okS && okF && okT) ? '' : 'none';
            });
        }
    </script>
}
