@model IEnumerable<FurryFriends.API.Models.DTO.BanHang.HoaDonBanHangDto>

@{
    ViewData["Title"] = "Quản lý Hóa đơn";
    var hoaDonCho = Model?.Where(h => h.TrangThai == "Chua Thanh Toan").OrderByDescending(h => h.NgayTao).ToList();
    var lichSuHoaDon = Model?.Where(h => h.TrangThai != "Chua Thanh Toan").OrderByDescending(h => h.NgayTao).ToList();
}

<div class="container-fluid py-4">
    <!-- Tiêu đề và nút tạo mới -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="fas fa-file-invoice-dollar me-2 text-primary"></i>@ViewData["Title"]</h2>
        <form asp-action="TaoHoaDonMoi" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i> Tạo Hóa Đơn Mới (Tại quầy)
            </button>
        </form>
    </div>

    <!-- Thống kê -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-start border-warning border-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Hóa đơn chờ</h6>
                    <h3 class="fw-bold text-warning mb-0">@(hoaDonCho?.Count() ?? 0)</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-start border-success border-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Thành công hôm nay</h6>
                    <h3 class="fw-bold text-success mb-0">@(Model?.Count(h => h.TrangThai == "Da Thanh Toan" && h.NgayTao.Date == DateTime.Today) ?? 0)</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-start border-danger border-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Bị hủy hôm nay</h6>
                    <h3 class="fw-bold text-danger mb-0">@(Model?.Count(h => h.TrangThai == "Da Huy" && h.NgayTao.Date == DateTime.Today) ?? 0)</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-start border-info border-4 h-100">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Tổng doanh thu hôm nay</h6>
                    <h3 class="fw-bold text-info mb-0">@(Model?.Where(h => h.TrangThai == "Da Thanh Toan" && h.NgayTao.Date == DateTime.Today).Sum(h => h.ThanhTien).ToString("N0") ?? "0") ₫</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách hóa đơn chờ -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0 text-warning"><i class="fas fa-clock me-2"></i>Hóa đơn đang chờ (@(hoaDonCho?.Count() ?? 0))</h5>
        </div>
        <div class="card-body p-0">
            @if (hoaDonCho != null && hoaDonCho.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in hoaDonCho)
                    {
                        <a asp-action="Details" asp-route-id="@item.HoaDonId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold me-3">@item.MaHoaDon</span>
                                <i class="fas fa-user me-1 text-muted"></i>
                                <span>@item.KhachHang.TenKhachHang</span>
                            </div>
                            <div>
                                <span class="me-4"><i class="far fa-calendar-alt me-2 text-muted"></i>@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</span>
                                <span class="badge bg-warning rounded-pill">Chờ thanh toán</span>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="text-center p-4 text-muted">Chưa có hóa đơn nào đang chờ.</div>
            }
        </div>
    </div>

    <!-- Lịch sử hóa đơn (với bộ lọc) -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-history me-2"></i>Lịch sử giao dịch</h5>
        </div>
        <div class="card-body p-4">
            <!-- Bộ lọc -->
            <div class="row g-2 mb-3 align-items-end">
                <div class="col-md-4">
                    <label for="searchInput" class="form-label small">Tìm theo mã HĐ, tên KH</label>
                    <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Nhập từ khóa...">
                </div>
                <div class="col-md-3">
                    <label for="statusFilter" class="form-label small">Trạng thái</label>
                    <select id="statusFilter" class="form-select form-select-sm">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Da Thanh Toan">Đã thanh toán</option>
                        <option value="Da Huy">Đã hủy</option>
                        <!-- Thêm các trạng thái khác nếu có -->
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">Khoảng ngày tạo</label>
                    <div class="input-group input-group-sm">
                        <input type="date" id="startDate" class="form-control">
                        <span class="input-group-text">đến</span>
                        <input type="date" id="endDate" class="form-control">
                    </div>
                </div>
                <div class="col-md-1">
                    <button id="resetFilters" class="btn btn-sm btn-outline-secondary w-100">Reset</button>
                </div>
            </div>

            <table class="table table-hover table-bordered" id="historyTable" style="width:100%">
                <thead class="table-light">
                    <tr>
                        <th>Mã HĐ</th>
                        <th>Khách Hàng</th>
                        <th>Ngày Tạo</th>
                        <th class="text-end">Thành Tiền</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lichSuHoaDon != null)
                    {
                        @foreach (var item in lichSuHoaDon)
                        {
                            <tr data-date="@item.NgayTao.ToString("yyyy-MM-dd")">
                                <td>@item.MaHoaDon</td>
                                <td>@item.KhachHang.TenKhachHang</td>
                                <td>@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end fw-semibold">@item.ThanhTien.ToString("N0") ₫</td>
                                <td class="text-center">
                                    @{
                                        var badgeClass = item.TrangThai switch
                                        {
                                            "Da Thanh Toan" => "bg-success-subtle text-success-emphasis border border-success-subtle",
                                            "Da Huy" => "bg-danger-subtle text-danger-emphasis border border-danger-subtle",
                                            _ => "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle"
                                        };
                                    }
                                    <span class="badge @badgeClass">@item.TrangThai.Replace("_", " ")</span>
                                </td>
                                <td class="text-center">
                                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@item.HoaDonId" title="Xem chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.js"></script>
    <script>
        $(document).ready(function() {
            var table = $('#historyTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/2.0.8/i18n/vi.json'
                },
                order: [[2, 'desc']], // Sắp xếp theo ngày tạo mới nhất
                columnDefs: [
                    { "orderable": false, "targets": [5] }
                ]
            });

            // Logic lọc tùy chỉnh
            function applyFilters() {
                var search = $('#searchInput').val().toLowerCase();
                var status = $('#statusFilter').val();
                var startDate = $('#startDate').val();
                var endDate = $('#endDate').val();

                // Lọc theo tìm kiếm và trạng thái
                table.column(0).search(search).column(4).search(status).draw();

                // Lọc theo ngày tháng (cần đăng ký custom filter)
                $.fn.dataTable.ext.search.push(
                    function(settings, data, dataIndex) {
                        if (settings.nTable.id !== 'historyTable') {
                            return true;
                        }

                        var min = startDate;
                        var max = endDate;
                        var date = $(table.row(dataIndex).node()).data('date');

                        if (
                            (min === "" || min === null || date >= min) &&
                            (max === "" || max === null || date <= max)
                        ) {
                            return true;
                        }
                        return false;
                    }
                );
                table.draw();
                // Xóa custom filter sau khi vẽ để không ảnh hưởng các lần draw khác
                $.fn.dataTable.ext.search.pop();
            }

            // Gắn sự kiện cho các input lọc
            $('#searchInput, #statusFilter, #startDate, #endDate').on('keyup change', function() {
                applyFilters();
            });

            // Reset bộ lọc
            $('#resetFilters').on('click', function() {
                $('#searchInput, #statusFilter, #startDate, #endDate').val('');
                table.search('').columns().search('').draw();
            });
        });
    </script>
}