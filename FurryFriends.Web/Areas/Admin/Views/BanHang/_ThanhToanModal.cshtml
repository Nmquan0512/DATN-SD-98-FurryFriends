@model dynamic
<div class="modal fade" id="thanhToanModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ThanhToan" asp-route-hoaDonId="@Model.Model.HoaDonId" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Xác Nhận Thanh Toán</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <h5>Tổng tiền: <span class="text-success">@Model.Model.ThanhTien.ToString("N0") ₫</span></h5>
                    <div class="mb-3">
                        <label class="form-label">Hình thức thanh toán (*)</label>
                        <select name="HinhThucThanhToanId" class="form-select" required>
                            @foreach (var httt in Model.HinhThucThanhToanList)
                            {
                                <option value="@httt.HinhThucThanhToanId">@httt.TenHinhThuc</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tiền khách đưa</label>
                        <input type="number" name="TienKhachDua" class="form-control" />
                    </div>
                     <div class="mb-3">
                        <label class="form-label">Ghi chú</label>
                        <textarea name="GhiChuThanhToan" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Xác Nhận</button>
                </div>
            </form>
        </div>
    </div>
</div>```

