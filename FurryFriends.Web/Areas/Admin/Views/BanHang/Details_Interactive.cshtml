                <div class="card-header bg-light py-3"><h6 class="m-0 fw-bold text-primary"><i class="fas fa-calculator me-2"></i>Tổng Kết Hóa Đơn</h6></div>
                <div class="card-body p-4" id="summaryContainer"></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Tìm kiếm Sản phẩm -->
