@model FurryFriends.Web.ViewModels.PhieuHoanTraViewModel
@{
    ViewData["Title"] = "Chi tiết yêu cầu hoàn trả";
    Layout = "_Layout";
    string StatusText(int s) => s switch { 0 => "Đang chờ duyệt", 1 => "Đã duyệt", 2 => "Bị từ chối", 3 => "Hoàn thành", _ => "Không xác định" };
    string StatusClass(int s) => s switch { 0 => "badge bg-warning text-dark", 1 => "badge bg-info text-dark", 2 => "badge bg-danger", 3 => "badge bg-success", _ => "badge bg-secondary" };
    string Img(string? p)
    {
        if (string.IsNullOrWhiteSpace(p)) return "";
        if (p.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return p;
        if (p.Contains("/")) return "https://localhost:7289/" + p.TrimStart('/');
        return $"https://localhost:7289/images/{System.IO.Path.GetFileName(p)}";
    }
    var img = Img(Model.AnhSanPham);
}
<section class="container py-4">
    <div class="d-flex align-items-center mb-3">
        <a asp-area="Admin" asp-controller="PhieuHoanTra" asp-action="Index" class="btn btn-sm btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <h3 class="mb-0">Chi tiết yêu cầu hoàn trả</h3>
        <div class="ms-auto">
            <span class="@StatusClass(Model.TrangThai)">@StatusText(Model.TrangThai)</span>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Sản phẩm</div>
                <div class="card-body d-flex gap-3">
                    @if (!string.IsNullOrEmpty(img))
                    {
                        <img src="@img" class="rounded" style="width:120px;height:120px;object-fit:cover;border:1px solid #eee;" />
                    }
                    <div>
                        <div class="fw-bold fs-5">@Model.TenSanPham</div>
                        <div class="text-muted">Màu: @Model.MauSac • Size: @Model.KichCo</div>
                        <div class="mt-2">Số lượng yêu cầu hoàn: <span class="fw-bold">@Model.SoLuongHoan</span></div>
                        <div class="mt-2 text-muted">Mã CTHĐ: @Model.HoaDonChiTietId</div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header fw-semibold">Lý do hoàn trả</div>
                <div class="card-body">
                    @if (string.IsNullOrWhiteSpace(Model.LyDoHoanTra))
                    {
                        <span class="text-muted">—</span>
                    }
                    else
                    {
                        <div>@Model.LyDoHoanTra</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Khách hàng</div>
                <div class="card-body">
                    <div class="mb-1"><span class="text-muted">Họ tên:</span> <span class="fw-semibold">@Model.HoTenKhach</span></div>
                    <div class="mb-1"><span class="text-muted">SĐT:</span> @Model.SdtKhach</div>
                    <div class="mb-1"><span class="text-muted">Email:</span> @Model.EmailKhach</div>
                    <div class="mb-1"><span class="text-muted">Địa chỉ:</span> @Model.DiaChiNhanHang</div>
                    <div class="text-muted small mt-2">Khách hàng ID: @Model.KhachHangId</div>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header fw-semibold">Thông tin yêu cầu</div>
                <div class="card-body">
                    <div class="mb-1"><span class="text-muted">Mã phiếu:</span> @Model.PhieuHoanTraId</div>
                    <div class="mb-1"><span class="text-muted">Ngày tạo:</span> @Model.NgayHoanTra.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class=""><span class="text-muted">Trạng thái:</span> <span class="@StatusClass(Model.TrangThai)">@StatusText(Model.TrangThai)</span></div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <a asp-area="Admin" asp-controller="PhieuHoanTra" asp-action="Edit" asp-route-id="@Model.PhieuHoanTraId" class="btn btn-primary">
                    <i class="bi bi-check2-circle"></i> Duyệt / Cập nhật
                </a>
                <a asp-area="Admin" asp-controller="PhieuHoanTra" asp-action="Index" class="btn btn-outline-secondary">Đóng</a>
            </div>
        </div>
    </div>
</section>
