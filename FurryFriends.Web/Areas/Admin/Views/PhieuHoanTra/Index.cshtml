@model IEnumerable<FurryFriends.Web.ViewModels.PhieuHoanTraViewModel>
@{
    ViewData["Title"] = "Yêu cầu hoàn trả";
    Layout = "_Layout";
    string StatusText(int s) => s switch { 0 => "Đang chờ duyệt", 1 => "Đã duyệt", 2 => "Bị từ chối", 3 => "Hoàn thành", _ => "Không xác định" };
    string StatusClass(int s) => s switch { 0 => "badge bg-warning text-dark", 1 => "badge bg-info text-dark", 2 => "badge bg-danger", 3 => "badge bg-success", _ => "badge bg-secondary" };
    string Img(string? p)
    {
        if (string.IsNullOrWhiteSpace(p)) return "";
        if (p.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return p;
        if (p.Contains("/")) return "https://localhost:7289/" + p.TrimStart('/');
        return $"https://localhost:7289/images/{System.IO.Path.GetFileName(p)}";
    }
}
<section class="container py-4">
    <div class="d-flex align-items-center mb-3">
        <h2 class="mb-0 me-3"><i class="bi bi-arrow-counterclockwise"></i> Yêu cầu hoàn trả</h2>
        <span class="text-muted">(@Model?.Count() ?? 0 mục)</span>
        <div class="ms-auto">
            <form method="get" class="d-flex" role="search">
                <input class="form-control form-control-sm me-2" name="q" placeholder="Tìm theo tên KH, SĐT, sản phẩm..." />
                <button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i> Tìm</button>
            </form>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded bg-white">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:72px;"></th>
                    <th>Sản phẩm</th>
                    <th>Khách hàng</th>
                    <th>Số lượng</th>
                    <th>Lý do</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">Chưa có yêu cầu hoàn trả nào.</td>
                    </tr>
                }
                else
                {
                    foreach (var i in Model)
                    {
                        var img = Img(i.AnhSanPham);
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(img))
                                {
                                    <img src="@img" alt="img" class="rounded" style="width:56px;height:56px;object-fit:cover;border:1px solid #eee;" />
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@i.TenSanPham</div>
                                <small class="text-muted">Màu: @i.MauSac • Size: @i.KichCo</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@i.HoTenKhach</div>
                                <small class="text-muted">@i.SdtKhach<br />@i.EmailKhach</small>
                            </td>
                            <td class="fw-semibold">@i.SoLuongHoan</td>
                            <td>
                                <div class="text-truncate" style="max-width:260px" title="@i.LyDoHoanTra">@i.LyDoHoanTra</div>
                            </td>
                            <td>@i.NgayHoanTra.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="@StatusClass(i.TrangThai)">@StatusText(i.TrangThai)</span></td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="PhieuHoanTra" asp-action="Details" asp-route-id="@i.PhieuHoanTraId"
                                   class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-eye"></i> Chi tiết</a>
                                <a asp-area="Admin" asp-controller="PhieuHoanTra" asp-action="Edit" asp-route-id="@i.PhieuHoanTraId"
                                   class="btn btn-sm btn-primary"><i class="bi bi-check2-circle"></i> Duyệt / Cập nhật</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
