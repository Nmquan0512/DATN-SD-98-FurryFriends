@model FurryFriends.Web.ViewModels.PhieuHoanTraUpdateRequest
@{
    ViewData["Title"] = "Cập nhật trạng thái";
    Layout = "_Layout";
    // Lấy readonly info từ ViewBag.Phieu (load trong action Edit GET nếu bạn muốn hiển thị phụ)
    var phieu = ViewBag.Phieu as FurryFriends.Web.ViewModels.PhieuHoanTraViewModel;
    string StatusText(int s) => s switch { 0 => "Đang chờ duyệt", 1 => "Đã duyệt", 2 => "Bị từ chối", 3 => "Hoàn thành", _ => "Không xác định" };
}
<section class="container py-4">
    <div class="d-flex align-items-center mb-3">
        <a asp-area="Admin" asp-controller="PhieuHoanTra" asp-action="Index" class="btn btn-sm btn-outline-secondary me-2">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <h3 class="mb-0">Duyệt / Cập nhật trạng thái</h3>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Thông tin (chỉ đọc)</div>
                <div class="card-body">
                    @if (phieu != null)
                    {
                        <div class="d-flex gap-3">
                            @{
                                string Img(string? p)
                                {
                                    if (string.IsNullOrWhiteSpace(p)) return "";
                                    if (p.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return p;
                                    if (p.Contains("/")) return "https://localhost:7289/" + p.TrimStart('/');
                                    return $"https://localhost:7289/images/{System.IO.Path.GetFileName(p)}";
                                }
                                var img = Img(phieu.AnhSanPham);
                            }
                            @if (!string.IsNullOrEmpty(img))
                            {
                                <img src="@img" class="rounded" style="width:110px;height:110px;object-fit:cover;border:1px solid #eee;" />
                            }
                            <div>
                                <div class="fw-bold">@phieu.TenSanPham</div>
                                <div class="text-muted">Màu: @phieu.MauSac • Size: @phieu.KichCo</div>
                                <div class="mt-2">Số lượng yêu cầu hoàn: <span class="fw-semibold">@phieu.SoLuongHoan</span></div>
                                <div class="mt-2 text-muted">Lý do: @phieu.LyDoHoanTra</div>
                                <div class="mt-2 text-muted">Ngày tạo: @phieu.NgayHoanTra.ToString("dd/MM/yyyy HH:mm")</div>
                                <div class="mt-2">Khách: <span class="fw-semibold">@phieu.HoTenKhach</span> — @phieu.SdtKhach</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">Không có thông tin phụ để hiển thị.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Cập nhật trạng thái</div>
                <div class="card-body">
                    @* form post tới /Admin/PhieuHoanTra/Edit/{id} *@
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Trạng thái</label>
                            <select asp-for="TrangThai" class="form-select">
                                <option value="0">Đang chờ duyệt</option>
                                <option value="1">Đã duyệt</option>
                                <option value="2">Bị từ chối</option>
                                <option value="3">Hoàn thành</option>
                            </select>
                            <span class="form-text text-muted">Admin chỉ được phép đổi trạng thái, không sửa số lượng/lý do.</span>
                        </div>

                        @* Giữ nguyên 2 field sau nhưng readonly/hidden để controller binding không lỗi nếu bạn vẫn để trong model *@
                        <input type="hidden" asp-for="SoLuongHoan" />
                        <input type="hidden" asp-for="LyDoHoanTra" />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2-circle"></i> Lưu thay đổi
                            </button>
                            <a asp-area="Admin" asp-controller="PhieuHoanTra" asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                        </div>
                    </form>
                </div>
            </div>

            @if (phieu != null)
            {
                <div class="card shadow-sm mt-3">
                    <div class="card-header fw-semibold">Trạng thái hiện tại</div>
                    <div class="card-body">
                        <div>Phiếu: <span class="text-muted">@phieu.PhieuHoanTraId</span></div>
                        <div>Đang là: <span class="fw-semibold">@StatusText(phieu.TrangThai)</span></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
